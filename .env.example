# Copy this file to .env and change the values if you need to.
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# .env is listed in .gitignore, so your real values are never committed.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- PostgreSQL (docker-compose.yml uses these same values) ---
POSTGRES_DB=pokedex
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=pokedex

# --- PokeAPI (no API key needed) ---
POKEAPI_BASE_URL=https://pokeapi.co/api/v2/
# Seconds to wait between two real network calls to PokeAPI (be polite).
POKEAPI_REQUEST_DELAY=0.2
